#!/bin/bash
# ============================================================
#  TLS Security Assessment - ONE-CLICK RUN ALL
#  ICSCCT 2026 Paper: "Security Risk Assessment of TLS
#  Configurations in Fintech Payment Systems"
#
#  Usage: bash run-all.sh
#  Prerequisites: Docker Desktop running + Python 3.10+
# ============================================================

set -e
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║   TLS Security Assessment Testbed - Full Pipeline Run    ║${NC}"
echo -e "${BLUE}║   ICSCCT 2026 Paper Experimental Setup                   ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""

# ============ CHECK PREREQUISITES ============
echo -e "${YELLOW}[0/6] Checking prerequisites...${NC}"

if ! command -v docker &>/dev/null; then
    echo -e "${RED}ERROR: Docker not found. Install Docker Desktop first.${NC}"
    echo "Download: https://www.docker.com/products/docker-desktop/"
    exit 1
fi

if ! command -v python3 &>/dev/null && ! command -v python &>/dev/null; then
    echo -e "${RED}ERROR: Python not found. Install Python 3.10+${NC}"
    echo "Download: https://www.python.org/downloads/"
    exit 1
fi

PYTHON=$(command -v python3 || command -v python)
echo -e "${GREEN}  ✓ Docker: $(docker --version | head -1)${NC}"
echo -e "${GREEN}  ✓ Python: $($PYTHON --version)${NC}"
echo -e "${GREEN}  ✓ Docker Compose: $(docker compose version 2>/dev/null || echo 'checking...')${NC}"
echo ""

# ============ STEP 1: Generate Certificates ============
echo -e "${YELLOW}[1/6] Generating TLS certificates...${NC}"
mkdir -p certs results

if [ ! -f certs/server.crt ]; then
    # Try mkcert first, fall back to openssl
    if command -v mkcert &>/dev/null; then
        echo "  Using mkcert..."
        mkcert -install 2>/dev/null || true
        mkcert -key-file certs/server.key -cert-file certs/server.crt \
            localhost 127.0.0.1 payment.local tls12.payment.local tls13.payment.local
    else
        echo "  mkcert not found, using openssl self-signed..."
        openssl req -new -x509 -nodes \
            -keyout certs/server.key -out certs/server.crt \
            -days 365 -subj "/C=VN/ST=DaNang/O=FintechLab/CN=payment.local" \
            -addext "subjectAltName=DNS:localhost,DNS:payment.local,IP:127.0.0.1" 2>/dev/null
    fi
    echo -e "${GREEN}  ✓ Certificate generated${NC}"
else
    echo -e "${GREEN}  ✓ Certificate already exists${NC}"
fi

if [ ! -f certs/dhparam.pem ]; then
    echo "  Generating DH parameters (this takes ~1 minute)..."
    openssl dhparam -out certs/dhparam.pem 2048 2>/dev/null
    echo -e "${GREEN}  ✓ DH parameters generated${NC}"
else
    echo -e "${GREEN}  ✓ DH parameters already exist${NC}"
fi
echo ""

# ============ STEP 2: Start Docker Testbed ============
echo -e "${YELLOW}[2/6] Starting Docker testbed...${NC}"
docker compose down 2>/dev/null || true
docker compose up -d --build

echo "  Waiting 10s for services to start..."
sleep 10

# Verify
echo "  Testing endpoints..."
TLS12_OK=$(curl -sk -o /dev/null -w "%{http_code}" https://localhost:8443/health 2>/dev/null || echo "000")
TLS13_OK=$(curl -sk -o /dev/null -w "%{http_code}" https://localhost:9443/health 2>/dev/null || echo "000")

if [ "$TLS12_OK" = "200" ] && [ "$TLS13_OK" = "200" ]; then
    echo -e "${GREEN}  ✓ TLS 1.2 endpoint (port 8443): OK${NC}"
    echo -e "${GREEN}  ✓ TLS 1.3 endpoint (port 9443): OK${NC}"
else
    echo -e "${RED}  ⚠ Endpoints may not be ready. TLS1.2=$TLS12_OK TLS1.3=$TLS13_OK${NC}"
    echo "  Waiting 10 more seconds..."
    sleep 10
fi
echo ""

# ============ STEP 3: Run testssl.sh Scans ============
echo -e "${YELLOW}[3/6] Running testssl.sh security scans...${NC}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

echo "  Scanning TLS 1.2 endpoint..."
docker exec testssl-scanner /opt/testssl.sh/testssl.sh \
    --jsonfile /tmp/tls12_results.json \
    --severity LOW --sneaky --color 0 \
    nginx-tls12:443 > results/testssl_tls12_${TIMESTAMP}.log 2>&1 || true
docker cp testssl-scanner:/tmp/tls12_results.json results/testssl_tls12.json 2>/dev/null || true

echo "  Scanning TLS 1.3 endpoint..."
docker exec testssl-scanner /opt/testssl.sh/testssl.sh \
    --jsonfile /tmp/tls13_results.json \
    --severity LOW --sneaky --color 0 \
    nginx-tls13:443 > results/testssl_tls13_${TIMESTAMP}.log 2>&1 || true
docker cp testssl-scanner:/tmp/tls13_results.json results/testssl_tls13.json 2>/dev/null || true

echo -e "${GREEN}  ✓ testssl.sh scans complete${NC}"
echo ""

# ============ STEP 4: Run SSLyze Scans ============
echo -e "${YELLOW}[4/6] Running SSLyze scans...${NC}"
$PYTHON -m pip install sslyze --quiet 2>/dev/null || pip install sslyze --quiet 2>/dev/null || true

$PYTHON -m sslyze --json_out=results/sslyze_tls12.json localhost:8443 > results/sslyze_tls12.log 2>&1 || true
$PYTHON -m sslyze --json_out=results/sslyze_tls13.json localhost:9443 > results/sslyze_tls13.log 2>&1 || true

echo -e "${GREEN}  ✓ SSLyze scans complete${NC}"
echo ""

# ============ STEP 5: Run Locust Load Tests ============
echo -e "${YELLOW}[5/6] Running Locust load tests (8 rounds × 60s each ≈ 8 minutes)...${NC}"
$PYTHON -m pip install locust --quiet 2>/dev/null || pip install locust --quiet 2>/dev/null || true

for USERS in 50 100 200 500; do
    for VER in tls12 tls13; do
        PORT=$([[ "$VER" == "tls12" ]] && echo 8443 || echo 9443)
        echo "  Testing $VER with $USERS users..."
        $PYTHON -m locust -f scripts/locustfile.py \
            --host=https://localhost:$PORT --headless \
            -u $USERS -r 20 --run-time=60s \
            --csv=results/locust_${VER}_u${USERS} \
            --only-summary 2>/dev/null || true
    done
done

echo -e "${GREEN}  ✓ Load tests complete (8 CSV files)${NC}"
echo ""

# ============ STEP 6: Generate Charts ============
echo -e "${YELLOW}[6/6] Generating charts and analysis...${NC}"
$PYTHON -m pip install pandas matplotlib seaborn --quiet 2>/dev/null || true
$PYTHON scripts/analyze-results.py

echo ""
echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║   ✅ ALL DONE! Results are in the results/ folder        ║${NC}"
echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""
echo "Output files:"
ls -la results/*.json results/*.csv results/charts/*.png 2>/dev/null
echo ""
echo "Next steps:"
echo "  1. Copy charts from results/charts/ into your paper"
echo "  2. Optional: Run 'python3 scripts/scan-ssllabs.py' for real-world Fintech data"
echo "  3. Run 'docker compose down' when finished"
